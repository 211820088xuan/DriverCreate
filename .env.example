# driver_create 环境变量配置示例
# 复制为 .env 并填入实际值，或直接在 ~/.bashrc 中 export

# ============================================================
# Neo4j 图谱数据库（step1_prepare.py 查询项目情报）
# ============================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here  # 必需：真实密码不能硬编码在源码中
NEO4J_DATABASE=neo4j

# ============================================================
# LLM API 配置（step2_generate.py 生成 driver）
# ============================================================
LLM_PROVIDER=deepseek  # 当前仅支持 deepseek（OpenAI 兼容接口）

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_FAST_MODEL=deepseek-v4-flash

# ============================================================
# 目录路径覆盖（可选，默认值适配当前部署环境）
# ============================================================
# OSS_FUZZ_DIR=/root/gyx/oss-fuzz
# SH_DIR=/root/gyx/sh
# PROJECTS_DIR=/root/gyx/projects

# ============================================================
# Agent 调优参数（可选）
# ============================================================
# DC_MAX_COMPILE_STEPS_PER_DRIVER=3
# DC_MAX_TEMPLATE_EDITS=2
# STEP2_MAX_WORKERS=8
